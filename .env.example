# =============================================================================
# VIP — root environment variables (Python ingestion only)
# =============================================================================
# Copy this file to `.env` and fill in DATABASE_URL with your Supabase
# Postgres connection string (Settings → Database → "Connection string" → URI).
# Used by src/ingest_aida.py.
#
# The web app reads a separate .env.local inside web/. See web/.env.example.
# =============================================================================

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
