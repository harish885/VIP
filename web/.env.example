# =============================================================================
# VIP — Web environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# See docs/PHASE_03_SETUP.md for where each value comes from.
# =============================================================================

# Supabase project URL — Settings → API → "Project URL"
# Same value is used by the browser, server, and service clients.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon key — safe to ship to the browser. Settings → API → "anon public".
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key — SERVER ONLY. Bypasses RLS. Settings → API → "service_role".
# NEVER prefix with NEXT_PUBLIC_; never reference from a client component.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
